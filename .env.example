# Leave the Supabase values empty to run in demo mode (seeded in-memory store, role switcher in the top bar).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by seed scripts and admin operations. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Transactional email (Phase 3)
RESEND_API_KEY=
EMAIL_FROM="Konnect Hub <hub@konnectortech.com>"
# Claude API for AI assist (Phase 5). Server-side only.
ANTHROPIC_API_KEY=
# Monitoring
SENTRY_DSN=
