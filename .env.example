# Leave the Supabase values empty to run in demo mode (seeded in-memory store, role switcher in the top bar).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS, so the app uses it only after its own permission check: Admin invites
# (auth.admin.inviteUserByEmail), banning deactivated users, and Storage (private bucket per client
# org, 5-minute signed download URLs). Required in Supabase mode. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Postgres connection for the real data path (lib/data/postgres.ts). Every request
# runs as `set local role authenticated` with the user's JWT claims, so RLS enforces access.
# On Supabase use the pooler connection string (Project Settings -> Database -> Connection
# pooling, transaction mode, port 6543) for a role that can `set role authenticated`
# (e.g. postgres, or a dedicated login role granted `authenticated`). Never expose it.
DATABASE_URL=
# Set to `postgres` to use DATABASE_URL without Supabase Auth (local dev on a seeded database;
# the demo persona switcher maps to the seed users). With Supabase configured it is implied.
KH_DATA=
# Google / Microsoft sign-in buttons on /auth/sign-in (Supabase Auth providers `google` and `azure`).
# Comma-separated subset, or `none`; empty shows both. Hidden in demo mode whatever the value.
# The client IDs and secrets live in the Supabase dashboard (Authentication -> Providers), not here.
AUTH_OAUTH_PROVIDERS=
# HMAC key for the kh_reauth cookie (fresh re-auth for gate/acceptance approvals) and the kh_preview
# cookie ("View as client"). Server-only. Falls back to 'dev-secret' in demo mode only: with Supabase
# configured it must be at least 32 random characters (e.g. `openssl rand -base64 48`) or approvals fail.
REAUTH_SECRET=
# Transactional email (Phase 3)
RESEND_API_KEY=
EMAIL_FROM="Konnect Hub <hub@konnectortech.com>"
# Claude API for AI assist (Phase 5). Server-side only: never prefix with NEXT_PUBLIC_.
# Without a key, demo mode (no Supabase) and CI use a deterministic fake; a Supabase deployment
# shows AI as unavailable. AI is still off per project until its Lead or an Admin turns it on.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
ANTHROPIC_MODEL=
# Optional: 'fake' forces the deterministic fake, 'off' disables AI assist on this server.
KH_AI_PROVIDER=
# AI requests per user per minute (default 10).
KH_AI_RATE_PER_MIN=
# Monitoring
SENTRY_DSN=
# Absolute base URL for links in emails and calendar feeds (e.g. https://hub.konnectortech.com).
APP_URL=
# HMAC key for personal calendar feed tokens (/api/projects/:key/calendar.ics). Rotating it revokes
# every feed URL. Falls back to 'dev-secret' in demo mode only; with Supabase configured it must be at
# least 32 characters, otherwise every feed answers 404.
ICS_SECRET=
# Shared secret for scheduled jobs: POST /api/raid/escalate and POST /api/notifications/digest
# send it as the `x-cron-secret` header. At least 16 characters; unset or shorter keeps both closed.
CRON_SECRET=
# Rate limiting (middleware.ts, lib/security/rate-limit.ts) is always on. `off` disables it for local
# load tests only; never set it in production.
KH_RATE_LIMIT=

# --- Tests only (never set in Vercel) -------------------------------------------------------------
# Set by supabase/tests/run-contract-tests.sh: runs the Postgres contract suites.
# TEST_DATABASE_URL=
# Throwaway test cluster: port (default 54329) and Postgres 16 binaries.
# KH_PG_PORT=54329
# PG_BIN=/usr/lib/postgresql/16/bin
# Playwright server port (default 3100). CI=1 starts a fresh server and retries once.
# PORT=3100

# KH-46 performance runs only (docs/performance.md): KH_LOAD=1 adds the 2×-scale load dataset to the
# in-memory demo store (120 projects, 20,000 items in project LOAD). Never set it in production.
KH_LOAD=
# Optional overrides for KH_LOAD: items in LOAD (default 20000), items in each other generated
# project (default 40), number of generated projects (default 120).
KH_LOAD_ITEMS=
KH_LOAD_OTHER_ITEMS=
KH_LOAD_PROJECTS=
